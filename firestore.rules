rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: Can read anyone's public profile. Can only write to their own profile (e.g., update bio, following list, saved posts).
    match /users/{userId} {
      allow read;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Posts: Publicly readable. Creations/deletions/updates have specific rules.
    match /posts/{postId} {
      allow read;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow updates only under specific conditions:
      // 1. Any authenticated user can update the 'likes' array.
      // 2. Only the post owner can update other fields (e.g., caption).
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])) ||
        (resource.data.userId == request.auth.uid)
      );

      // Comments subcollection: Any authenticated user can read and create comments.
      match /comments/{commentId} {
        allow read;
        allow create: if request.auth != null;
      }
    }
    
    // Chats: Users can only interact with chats they are a part of.
    match /chats/{chatId} {
      // Allow read/update if the requesting user's ID is in the userIds array of the chat document.
      allow read, update: if request.auth != null && request.auth.uid in resource.data.userIds;
      
      // Allow a user to create a chat if:
      // 1. They are logged in.
      // 2. Their own UID is in the `userIds` array of the new document.
      // 3. There are exactly two users in the chat.
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.userIds &&
                       request.resource.data.userIds.size() == 2;

      // Messages subcollection
      match /messages/{messageId} {
         // Allow read/create if the user is a participant in the parent chat document.
         allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
      }
    }
  }
}
